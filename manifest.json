{
  "permissions": ["webRequest", "storage", "activeTab"],
  "host_permissions": ["https://example.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "name": "HTTP/HTTPS Analyzer",
  "description": "Extensie de browser pentru analizarea cererilor HTTP/HTTPS și identificarea comportamentelor potențial suspecte",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "48": "https.png"
  },
  "action": {
    "default_popup": "analyzer.html",
    "default_icon": "https.png"
  }
}